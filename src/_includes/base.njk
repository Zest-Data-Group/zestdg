<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  {%- set pageTitle = title + " · " + site.name if title else site.name + " — " + site.tagline -%}
  {%- set pageDesc = description or site.description -%}
  {#- Drafts render with permalink:false, so page.url can be falsey. -#}
  {%- set canonical = (page.url or "/") | absoluteUrl %}
  <title>{{ pageTitle }}</title>
  <meta name="description" content="{{ pageDesc }}">
  <link rel="canonical" href="{{ canonical }}">

  <meta property="og:type" content="{{ ogType or 'website' }}">
  <meta property="og:site_name" content="{{ site.name }}">
  <meta property="og:title" content="{{ pageTitle }}">
  <meta property="og:description" content="{{ pageDesc }}">
  <meta property="og:url" content="{{ canonical }}">
  <meta property="og:locale" content="{{ site.locale }}">
  <meta property="og:image" content="{{ site.ogImage | absoluteUrl }}">
  <meta name="twitter:card" content="summary_large_image">

  <meta name="theme-color" content="#FAF0E6">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap">
  <link rel="icon" href="/img/mark.svg" type="image/svg+xml">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">

  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "ProfessionalService",
    "name": {{ site.legalName | dump | safe }},
    "alternateName": {{ site.name | dump | safe }},
    "url": {{ site.url | dump | safe }},
    "email": {{ ("mailto:" + site.email) | dump | safe }},
    "description": {{ site.description | dump | safe }},
    "founder": { "@type": "Person", "name": {{ site.author | dump | safe }} },
    "sameAs": [{{ site.github | dump | safe }}],
    "areaServed": "Worldwide",
    "knowsAbout": [
      "Geospatial analysis", "Species distribution modeling", "R programming",
      "Google Earth Engine", "Reproducible research", "Shiny applications"
    ]
  }
  </script>
</head>
<body>
  <a class="skip-link" href="#main">Skip to content</a>

  <header class="site-head">
    <a class="brand" href="/">
      <img src="/img/logo.svg" alt="" width="54" height="44">
      <span>{{ site.name }}</span>
    </a>
    <nav aria-label="Primary">
      {% set navItems = [
        { url: "/projects/", label: "Projects" },
        { url: "/publications/", label: "Publications" },
        { url: "/about/", label: "About" }
      ] %}
      {% for item in navItems %}
      <a href="{{ item.url }}"{% if page.url and page.url.startsWith(item.url) %} aria-current="page"{% endif %}>{{ item.label }}</a>
      {% endfor %}
      <a href="{{ site.github }}" rel="me noopener">GitHub</a>
    </nav>
  </header>

  <main id="main" class="{{ mainClass or 'prose' }}">
    {{ content | safe }}
  </main>

  <aside class="contact-block" aria-label="Contact">
    <div class="contact-inner">
      <p><strong>Interested in working with us?</strong> We take on a small number of projects at a time.
         Email <a href="mailto:{{ site.email }}">{{ site.email }}</a> to start the conversation.</p>
    </div>
  </aside>

  <footer class="site-foot">
    <img class="foot-photo" src="/img/oak.jpg" alt="" width="1600" height="689" loading="lazy">
    <div class="foot-inner">
      <p class="foot-name">{{ site.legalName }}</p>
      <p>{{ site.location }}</p>
      <p><a href="mailto:{{ site.email }}">{{ site.email }}</a> · <a href="{{ site.github }}" rel="me noopener">GitHub</a></p>
      <p class="foot-copy">&copy; {{ site.buildYear }} {{ site.legalName }}</p>
    </div>
  </footer>
</body>
</html>
